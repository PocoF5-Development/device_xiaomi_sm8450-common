rw_dir_file(hal_power_default, sysfs_thermal)

# Allow hal_power to access IThermal HAL
allow hal_power_default hal_thermal_service:service_manager find;
hal_client_domain(hal_power_default, hal_thermal)

# Allow hal_power to access IStats service
allow hal_power_default fwk_stats_service:service_manager find;

# cpu dma latency
allow hal_power_default vendor_latency_device:file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# ADPF updates app threads across per-app MLS categories.
typeattribute hal_power_default mlstrustedsubject;

# Apply per-thread uclamp for app and SurfaceFlinger hint sessions.
allow hal_power_default self:global_capability_class_set sys_nice;
allow hal_power_default { appdomain surfaceflinger }:process setsched;
